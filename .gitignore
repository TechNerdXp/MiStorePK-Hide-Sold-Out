# Build output — the zip is rebuilt from source by tooling_/build.js
dist/

# Tooling dependencies (the scripts themselves are committed in tooling_/)
node_modules/

# Verification sheets. Regenerated by the sheet-*.js and verify-live.js scripts
# and meant to be looked at, not kept.
tooling_/_verify/

# Store listing copy and the six store graphics. Submission material is kept
# local, as store_listing.md was before it moved into store/: the listing text
# carries submission notes and a frank read of the naming and colour decisions,
# and the graphics are captures of someone else's shopfront and product
# photography. Regenerate them with tooling_/gen-promo.js and gen-shots.js.
store/

# Captured mistore.pk markup, kept locally for selector work. It is someone
# else's page source, including their product photography, so it stays out of
# the public repo.
pillars_off_creation/

