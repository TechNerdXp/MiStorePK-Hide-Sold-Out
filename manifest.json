{
  "manifest_version": 3,
  "name": "MiStorePK Hide Sold Out",
  "version": "2.0",
  "description": "Hide sold-out products on mistore.pk, or switch to Peek and see them dimmed instead. One toggle, applied live.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hide Sold Out",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://mistore.pk/*",
        "*://www.mistore.pk/*",
        "*://mistorepk.myshopify.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "*://mistore.pk/*",
    "*://www.mistore.pk/*",
    "*://mistorepk.myshopify.com/*"
  ]
}
